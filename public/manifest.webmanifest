{
  "name": "Signature Capture",
  "short_name": "Signature",
  "description": "Open-source signature capture tool",
  "id": "https://signature.codeant.studio/",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "background_color": "#0d1711",
  "theme_color": "#0d1711",
  "icons": [
    {
      "src": "icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
